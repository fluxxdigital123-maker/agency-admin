{
  "name": "Weekly Digest",
  "description": "Every Monday at 08:00 (America/New_York), compiles a weekly agency digest \u2014 per-client views, posted clips, pipeline stage, overdue payments, and 30-day-guarantee flags \u2014 and emails it to the account owner. Skipped automatically when the digest toggle is off.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * 1",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_digest",
      "version": "1",
      "namespace": "base44"
    },
    "do": [
      {
        "send_digest": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateWeeklyDigest",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Compile and email the weekly digest",
            "description": "Gathers weekly metrics and sends the digest email; no-ops when the toggle is off"
          }
        }
      }
    ]
  }
}