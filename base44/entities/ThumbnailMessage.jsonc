{
  "name": "ThumbnailMessage",
  "type": "object",
  "properties": {
    "session": {
      "type": "string",
      "relation": "ThumbnailSession",
      "isForeignKey": true
    },
    "role": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "TEXT",
        "IMAGE"
      ],
      "default": "TEXT"
    },
    "content": {
      "type": "string"
    },
    "imageUrl": {
      "type": "string"
    },
    "variations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "session",
    "role",
    "content"
  ]
}