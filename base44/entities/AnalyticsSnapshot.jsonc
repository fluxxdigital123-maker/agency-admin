{
  "name": "AnalyticsSnapshot",
  "type": "object",
  "properties": {
    "client": {
      "type": "string",
      "relation": "Client",
      "isForeignKey": true
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "views": {
      "type": "number"
    },
    "subscribers": {
      "type": "number"
    },
    "watchHours": {
      "type": "number"
    },
    "impressionsCTR": {
      "type": "number"
    },
    "topVideos": {
      "type": "string"
    }
  },
  "required": [
    "client",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}