{
  "name": "Clip",
  "type": "object",
  "properties": {
    "client": {
      "type": "string",
      "relation": "Client",
      "isForeignKey": true
    },
    "title": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "YOUTUBE_SHORTS",
        "TIKTOK",
        "INSTAGRAM_REELS",
        "X",
        "LINKEDIN"
      ],
      "default": "YOUTUBE_SHORTS"
    },
    "sourceVideoUrl": {
      "type": "string"
    },
    "clipUrl": {
      "type": "string"
    },
    "editor": {
      "type": "string",
      "relation": "TeamMember",
      "isForeignKey": true
    },
    "status": {
      "type": "string",
      "enum": [
        "QUEUED",
        "EDITING",
        "REVIEW",
        "APPROVED",
        "POSTED"
      ],
      "default": "QUEUED"
    },
    "statusChangedAt": {
      "type": "string",
      "format": "date-time"
    },
    "scheduledDate": {
      "type": "string",
      "format": "date"
    },
    "postedDate": {
      "type": "string",
      "format": "date"
    },
    "clientApproval": {
      "type": "string",
      "enum": [
        "NOT_REQUIRED",
        "PENDING",
        "APPROVED",
        "CHANGES_REQUESTED"
      ],
      "default": "NOT_REQUIRED"
    },
    "clientFeedback": {
      "type": "string"
    },
    "views": {
      "type": "number"
    },
    "likes": {
      "type": "number"
    },
    "comments": {
      "type": "number"
    },
    "shares": {
      "type": "number"
    }
  },
  "required": [
    "client",
    "title",
    "platform"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}