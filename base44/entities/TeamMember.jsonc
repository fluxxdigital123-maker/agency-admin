{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "client": {
      "type": "string",
      "relation": "Client",
      "isForeignKey": true
    },
    "role": {
      "type": "string",
      "enum": [
        "CHANNEL_MANAGER",
        "SHORT_FORM_EDITOR",
        "LONG_FORM_EDITOR",
        "THUMBNAIL_DESIGNER"
      ]
    },
    "name": {
      "type": "string"
    },
    "cost": {
      "type": "number"
    },
    "paymentType": {
      "type": "string",
      "enum": [
        "FIXED_MONTHLY",
        "PER_CLIP",
        "PER_1000_VIEWS"
      ],
      "default": "FIXED_MONTHLY"
    },
    "rate": {
      "type": "number"
    }
  },
  "required": [
    "client",
    "role",
    "name"
  ]
}