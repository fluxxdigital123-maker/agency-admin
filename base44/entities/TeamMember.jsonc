{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "client": {
      "type": "string",
      "relation": "Client",
      "isForeignKey": true
    },
    "role": {
      "type": "string",
      "enum": [
        "CHANNEL_MANAGER",
        "SHORT_FORM_EDITOR",
        "LONG_FORM_EDITOR",
        "THUMBNAIL_DESIGNER"
      ]
    },
    "name": {
      "type": "string"
    },
    "cost": {
      "type": "number"
    },
    "paymentType": {
      "type": "string",
      "enum": [
        "FIXED_MONTHLY",
        "PER_CLIP",
        "PER_1000_VIEWS"
      ],
      "default": "FIXED_MONTHLY"
    },
    "rate": {
      "type": "number"
    }
  },
  "required": [
    "client",
    "role",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}