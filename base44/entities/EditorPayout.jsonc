{
  "name": "EditorPayout",
  "type": "object",
  "properties": {
    "teamMember": {
      "type": "string",
      "relation": "TeamMember",
      "isForeignKey": true
    },
    "client": {
      "type": "string",
      "relation": "Client",
      "isForeignKey": true
    },
    "month": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "paid": {
      "type": "boolean",
      "default": false
    },
    "paidDate": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "teamMember",
    "month"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}