{
  "name": "Notification",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "PAYMENT_OVERDUE",
        "CLIP_STUCK_REVIEW",
        "GUARANTEE_APPROACHING",
        "CLIENT_APPROVAL",
        "NEW_LEAD"
      ]
    },
    "message": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "client": {
      "type": "string",
      "relation": "Client",
      "isForeignKey": true
    },
    "clip": {
      "type": "string",
      "relation": "Clip",
      "isForeignKey": true
    }
  },
  "required": [
    "type",
    "message"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}