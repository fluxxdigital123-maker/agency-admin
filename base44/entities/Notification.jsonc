{
  "name": "Notification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "CLIENT_APPROVAL",
        "INFO"
      ],
      "default": "INFO"
    },
    "client": {
      "type": "string",
      "relation": "Client",
      "isForeignKey": true
    },
    "clip": {
      "type": "string",
      "relation": "Clip",
      "isForeignKey": true
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title"
  ]
}