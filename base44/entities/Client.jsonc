{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "channelUrl": {
      "type": "string"
    },
    "channelThumbnail": {
      "type": "string"
    },
    "channelSummary": {
      "type": "string"
    },
    "offers": {
      "type": "string"
    },
    "contentStrategy": {
      "type": "string"
    },
    "contentStyle": {
      "type": "string"
    },
    "growthOpportunities": {
      "type": "string"
    },
    "planType": {
      "type": "string",
      "enum": [
        "TEAM_ONLY",
        "PERSONAL_INVOLVED",
        "CUSTOM"
      ],
      "default": "TEAM_ONLY"
    },
    "customPlanLabel": {
      "type": "string"
    },
    "setupFee": {
      "type": "number",
      "default": 30000
    },
    "monthlyFee": {
      "type": "number"
    },
    "startDate": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "CHURNED"
      ],
      "default": "ACTIVE"
    },
    "churnDate": {
      "type": "string",
      "format": "date"
    },
    "discordServerId": {
      "type": "string"
    },
    "googleAccountEmail": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "baselineViews": {
      "type": "number"
    },
    "reviewToken": {
      "type": "string"
    },
    "suggestedTitles": {
      "type": "string"
    },
    "suggestedTitlesAt": {
      "type": "string",
      "format": "date-time"
    },
    "suggestedIdeas": {
      "type": "string"
    },
    "suggestedIdeasAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}