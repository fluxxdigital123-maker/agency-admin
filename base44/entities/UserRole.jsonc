{
  "name": "UserRole",
  "type": "object",
  "properties": {
    "userEmail": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "OWNER",
        "MANAGER",
        "EDITOR",
        "CLIENT"
      ],
      "default": "EDITOR"
    },
    "clientAccess": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "userEmail",
    "role"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}