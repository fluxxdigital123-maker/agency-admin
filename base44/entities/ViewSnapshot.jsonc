{
  "name": "ViewSnapshot",
  "type": "object",
  "properties": {
    "client": {
      "type": "string",
      "relation": "Client",
      "isForeignKey": true
    },
    "clip": {
      "type": "string",
      "relation": "Clip",
      "isForeignKey": true
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "platform": {
      "type": "string",
      "enum": [
        "YOUTUBE_SHORTS",
        "TIKTOK",
        "INSTAGRAM_REELS",
        "X",
        "LINKEDIN"
      ],
      "default": "YOUTUBE_SHORTS"
    },
    "views": {
      "type": "number"
    },
    "likes": {
      "type": "number"
    },
    "comments": {
      "type": "number"
    },
    "shares": {
      "type": "number"
    }
  },
  "required": [
    "client",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}