{
  "name": "KnowledgeEntry",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "enum": [
        "THUMBNAIL_GLOBAL",
        "VIDEO_GLOBAL",
        "CLIENT_TITLES",
        "CLIENT_IDEAS"
      ]
    },
    "client": {
      "type": "string",
      "relation": "Client",
      "isForeignKey": true
    },
    "userInput": {
      "type": "string"
    },
    "learnedPrinciple": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "scope",
    "userInput"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}