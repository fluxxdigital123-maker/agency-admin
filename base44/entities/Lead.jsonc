{
  "name": "Lead",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "channelUrl": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "TO_CONTACT",
        "CONTACTED",
        "IN_TALKS",
        "CLOSED",
        "LOST"
      ],
      "default": "TO_CONTACT"
    },
    "upfrontCash": {
      "type": "number"
    },
    "monthlyRecurring": {
      "type": "number"
    },
    "subscribers": {
      "type": "number"
    },
    "avgViews": {
      "type": "number"
    },
    "niche": {
      "type": "string"
    },
    "lastContactDate": {
      "type": "string",
      "format": "date"
    },
    "nextFollowUp": {
      "type": "string",
      "format": "date"
    },
    "score": {
      "type": "number"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}