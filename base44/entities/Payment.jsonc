{
  "name": "Payment",
  "type": "object",
  "properties": {
    "client": {
      "type": "string",
      "relation": "Client",
      "isForeignKey": true
    },
    "amount": {
      "type": "number"
    },
    "type": {
      "type": "string",
      "enum": [
        "SETUP",
        "MONTHLY"
      ]
    },
    "dueDate": {
      "type": "string",
      "format": "date"
    },
    "paidDate": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "PAID",
        "OVERDUE"
      ],
      "default": "PENDING"
    }
  },
  "required": [
    "client",
    "amount",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}